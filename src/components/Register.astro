---
import { topics } from '../site.config';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing'>[];
  /** Heading level for entry titles, so each page keeps a valid outline. */
  level?: 'h2' | 'h3';
}

const { posts, level: Tag = 'h3' } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<ul class="register">
  {
    posts.map((post) => (
      <li>
        <a class="entry" href={`/writing/${post.id}/`}>
          <span class="entry-side">
            <time class="entry-date" datetime={post.data.date.toISOString()}>
              {fmt(post.data.date)}
            </time>
            <span class="entry-topic">{topics[post.data.topic].label}</span>
          </span>
          <Tag class="entry-title">{post.data.title}</Tag>
          <p class="entry-desc">{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>
