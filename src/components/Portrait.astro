---
import { site } from '../site.config';

interface Props {
  /** 'sm' drops the amber corner rule and shrinks the frame. */
  size?: 'lg' | 'sm';
}
const { size = 'lg' } = Astro.props;
---

<figure class:list={['portrait', { 'portrait-sm': size === 'sm' }]}>
  <picture>
    <source
      type="image/webp"
      srcset="/paarth-280.webp 280w, /paarth-560.webp 560w"
      sizes="(min-width: 56rem) 240px, 160px"
    />
    <img
      src="/paarth-560.jpg"
      srcset="/paarth-280.jpg 280w, /paarth-560.jpg 560w"
      sizes="(min-width: 56rem) 240px, 160px"
      width="560"
      height="560"
      alt={`${site.name}, ${site.role}`}
      loading="eager"
      decoding="async"
    />
  </picture>
</figure>
