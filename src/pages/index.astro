---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Marker from '../components/Marker.astro';
import Register from '../components/Register.astro';
import Availability from '../components/Availability.astro';
import Credentials from '../components/Credentials.astro';
import Portrait from '../components/Portrait.astro';
import Contact from '../components/Contact.astro';
import { site, topics } from '../site.config';
import { services } from '../data/services';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<Base>
  <section class="shell hero">
    <div class="hero-grid">
      <div>
        <Availability />
        <h1 class="hero-name">{site.name}</h1>
        <p class="hero-role">{site.role}</p>
        <p class="hero-intro">{site.intro}</p>
        <div class="hero-actions">
          <a class="btn" href={site.calendly} target="_blank" rel="noopener">Book a 30-min call</a>
          <a class="btn btn-quiet" href="/writing">Read the writing</a>
        </div>
      </div>
      <Portrait />
    </div>
  </section>

  <section class="shell band-tight">
    <Marker label="Track record" />
    <Credentials />
  </section>

  <section class="shell band-tight">
    <Marker label="Two things I write about" />
    <div style="display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));">
      {
        Object.values(topics).map((topic) => (
          <div style="border-top: 2px solid var(--text); padding-top: 1.25rem;">
            <h3>{topic.label}</h3>
            <p style="margin-top: 0.75rem; color: var(--muted);">{topic.blurb}</p>
            <p style="margin-top: 1rem;">
              <a href={`/writing/topic/${topic.slug}/`}>Read this stream &rarr;</a>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="shell band-tight">
    <Marker label="Latest" />
    <Register posts={posts} />
    <p style="margin-top: 1.75rem;"><a href="/writing">All posts &rarr;</a></p>
  </section>

  <section class="band band-ink">
    <div class="shell">
      <Marker label="Coaching" />
      <div class="services">
        {
          services.map((service) => (
            <article class="service">
              <h3 class="service-title">{service.title}</h3>
              <p class="service-body">{service.summary}</p>
              <p class="service-meta">{service.meta}</p>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 2rem;"><a href="/coaching">How each one works &rarr;</a></p>
    </div>
  </section>

  <Contact />
</Base>
