---
import Base from '../layouts/Base.astro';
import Marker from '../components/Marker.astro';
import Availability from '../components/Availability.astro';
import Contact from '../components/Contact.astro';
import { services } from '../data/services';
---

<Base title="Coaching" description="Coaching for consulting and VC interviews, MBA admissions, and resumes.">
  <section class="shell band-tight" style="padding-top: clamp(3rem, 8vw, 5.5rem);">
    <Availability />
    <h1 style="margin-top: 1.25rem;">Coaching</h1>
    <p class="lede prose" style="margin-top: 1.5rem;">
      Three kinds of work, all of them one-to-one. We start with a call so I can tell you honestly
      whether I am the right person for what you need.
    </p>
  </section>

  <section class="shell band-tight">
    <Marker label="What I offer" />
    <div style="display: grid; gap: clamp(2.5rem, 6vw, 4rem);">
      {
        services.map((service) => (
          <article style="border-top: 1px solid var(--hairline); padding-top: 2rem;">
            <h3 style="font-size: var(--step-2);">{service.title}</h3>
            <p class="marker" style="margin-top: 1rem; margin-bottom: 1.25rem;">{service.meta}</p>
            <p class="prose">{service.detail}</p>
            <p style="margin-top: 2rem; font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);">
              What you get
            </p>
            <ul class="prose" style="margin-top: 0.9rem; padding-left: 1.3rem;">
              {service.deliverables.map((item) => (
                <li style="margin-top: 0.4rem;">{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <Contact />
</Base>
