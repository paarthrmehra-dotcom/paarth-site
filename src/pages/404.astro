---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="shell band">
    <p class="dimension">Error 404</p>
    <h1 style="max-width: 16ch;">That page is not here.</h1>
    <p class="lede prose" style="margin-top: 1.5rem;">
      The link may be old, or the address slightly off. The writing index is the best place to
      pick up the trail.
    </p>
    <p style="margin-top: 2.5rem;">
      <a class="btn" href="/">Back to the homepage</a>
    </p>
  </section>
</Base>
