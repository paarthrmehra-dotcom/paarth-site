---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Register from '../../components/Register.astro';
import { topics } from '../../site.config';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Writing" description="On venture capital, management consulting, portfolio management, interviews, MBA admissions and resumes.">
  <section class="shell band-tight" style="padding-top: clamp(3rem, 8vw, 5.5rem);">
    <h1>Writing</h1>
    <p class="lede prose" style="margin-top: 1.5rem;">
      Two streams. One on how investing and consulting actually work, one on getting into them.
    </p>
  </section>

  <section class="shell band-tight">
    <nav class="filter" aria-label="Filter by topic">
      <a href="/writing" aria-current="page">All</a>
      {
        Object.values(topics).map((topic) => (
          <a href={`/writing/topic/${topic.slug}/`}>{topic.label}</a>
        ))
      }
    </nav>
    <Register posts={posts} level="h2" />
  </section>
</Base>
